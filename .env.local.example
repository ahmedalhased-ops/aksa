# Copy this file to .env.local and fill in the real values from your
# Supabase project (Project Settings → API).

# Safe to expose to the browser — public URL + anon (public) key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER expose this one to the browser. Server-side only (API routes,
# server components). Used for admin writes and the place_order() call.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
